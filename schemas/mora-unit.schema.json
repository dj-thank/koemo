{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/mora-unit.schema.json",
  "title": "MoraUnit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "surface",
    "kana",
    "phones",
    "startMs",
    "endMs",
    "confidence",
    "type",
    "source",
    "charStart",
    "charEnd"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^mora-[0-9]{4,}$"},
    "surface": {"type": "string", "minLength": 1},
    "kana": {"type": "string", "minLength": 1},
    "phones": {"type": "array", "items": {"type": "string"}},
    "startMs": {"type": ["number", "null"], "minimum": 0},
    "endMs": {"type": ["number", "null"], "minimum": 0},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "type": {
      "enum": ["regular", "moraic-nasal", "geminate", "long-vowel"]
    },
    "source": {
      "enum": ["char-merge", "forced-aligner", "mora-ctc", "text-segmentation"]
    },
    "charStart": {"type": "integer", "minimum": 0},
    "charEnd": {"type": "integer", "minimum": 1}
  }
}
